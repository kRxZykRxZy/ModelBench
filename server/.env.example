# ============================================================
# ModelBench Backend — Production Environment
# Copy to .env:  cp .env.example .env
# ============================================================

# ---- Server ----
PORT=3000
# Your public site URL (no trailing slash). Used for CORS, webhook redirects, OpenReferer.
SITE_URL=https://your-site.example.com
# Comma-separated allowed origins for CORS (desktop app + website).
# ALLOWED_ORIGINS=https://your-site.example.com,http://localhost:3000
# Trust proxy: 1 if behind a reverse proxy (Nginx/Cloudflare), 0 otherwise.
TRUST_PROXY=1

# ---- Supabase (auth + database) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Whop (billing) ----
WHOP_API_KEY=your-whop-api-key
WHOP_WEBHOOK_SECRET=your-whop-webhook-secret
# Whop plan IDs mapped to our tiers (hobby=$7, scale=$25, teams=$149).
WHOP_PLAN_HOBBY=plan_xxx
WHOP_PLAN_SCALE=plan_xxx
WHOP_PLAN_TEAMS=plan_xxx
# Optional: allow unsigned webhooks in dev only. NEVER in production.
# ALLOW_UNSIGNED_WEBHOOKS=false

# ---- Cloud AI (OpenRouter) ----
# OpenRouter API key for paid-tier cloud AI credits.
OPENROUTER_API_KEY=sk-or-v1-xxx
# Force mock AI even with a key (dev only): AI_MOCK=false
# OPENROUTER_TIMEOUT_MS=180000

# ---- Rate limiting ----
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=60
CHECKOUT_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_MAX=120
# RATE_LIMIT_DISABLED=true   # dev only

# ---- Credits / mock (dev only) ----
# MOCK_STARTING_CREDITS=0
# MOCK_TOKEN_TTL_SECONDS=2592000
# LOW_BALANCE_THRESHOLD=1
